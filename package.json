{
  "name": "dsh-continuity",
  "version": "0.1.0",
  "description": "Local-first chat migration and reviewable character continuity for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0 <25",
    "dsh": "0.2.2-rc.4"
  },
  "packageManager": "pnpm@11.28.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/ui/client.d.ts",
      "node": "./dist/client-node.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "scripts",
    "docs",
    ".github",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.build.json",
    "vitest.config.ts",
    "vitest.pinned.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    ".node-version",
    ".npmrc",
    ".prettierrc.json",
    ".prettierignore",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "COMPATIBILITY.json",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/security",
    "test:integration": "vitest run tests/integration",
    "test:runtime": "vitest run tests/e2e/runtime",
    "test:pinned": "node scripts/test-pinned.mjs",
    "test:mobile": "node scripts/test-mobile.mjs",
    "test:evaluation": "vitest run tests/evaluation",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:docs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-deepseek-chat-import": "0.2.2-rc.4",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.4",
    "@deepseek-ai/schemastery": "~3.19.0",
    "fflate": "0.8.3",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-web": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.4",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.4",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.4",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-web": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.4",
    "@deepseek-ai/dsh-host-frontend-static": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.4",
    "@deepseek-ai/dsh": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.4",
    "@deepseek-ai/dsh-web": "0.2.2-rc.4",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "use-sync-external-store": "1.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.11",
    "yaml": "^2.8.0"
  }
}
